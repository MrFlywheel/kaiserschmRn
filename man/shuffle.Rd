\name{shuffle}
\alias{shuffle}
%- Crop point clouds with polygons
\title{
Return a shuffled version of a data.frame
}
\description{
The order of rows within a data.frame is changed and returned in a shuffled order.
}
\usage{
shuffle(x)
}

\arguments{
  \item{x}{
A dataframe.
}
}
